class Handler(http.server.BaseHTTPRequestHandler):
    # Per-connection socket timeout. Without this, a client that opens a
    # connection and then stalls mid-request (a backgrounded browser tab, a
    # laptop sleep/wake, a localhost socket blip) would block its worker
    # indefinitely. With ThreadingHTTPServer below, a wedged worker no longer
    # freezes the whole server, but the timeout still reclaims the thread.
    timeout = 15

    def log_message(self, format, *args):
        # Suppress default request logging
        pass

    def _headers(self, content_type="application/json", status=200):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()

    def _read_file(self, path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                return f.read(), True
        except FileNotFoundError:
            return "", False
        except Exception as e:
            return f"Error reading file: {e}", False

    def _file_age(self, path):
        try:
            import time
            return time.time() - os.path.getmtime(path)
        except Exception:
            return None

    # Map the orchestrator's most recent event to a UI mode. Markdown markers
    # in orchestrator-live.md are inconsistent across sessions ("## Current"
    # vs "## Status", with-marker vs free text), but the events log is
    # structured and append-only — the most recent event reliably tells us
    # what the orchestrator is doing right now. Any event not in this map
    # leaves mode unset and falls back to the age-based logic.
    LAST_EVENT_TO_MODE = {
        "session_start": "setup",
        "gate_hit": "gate",
        "session_end": "done",
        "task_error": "error",
        "bugfix_failure": "error",
    }

    def _parse_mode(self, events):
        if not events:
            return None
        last = events[-1].get("event") if isinstance(events[-1], dict) else None
        return self.LAST_EVENT_TO_MODE.get(last)

    def _read_warnings(self):
        """Read .guard-state/events.jsonl and return the most recent
        warning-class events. Filters out noise (guard_allow, tracker_record).
        Returns up to MAX_WARNINGS_RETURNED events, newest last."""
        content, exists = self._read_file(GUARD_EVENTS_JSONL)
        if not exists or not content.strip():
            return []
        warnings = []
        for line in content.strip().split("\n"):
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("event") in WARNING_EVENT_TYPES:
                warnings.append(ev)
        return warnings[-MAX_WARNINGS_RETURNED:]

    def do_GET(self):
        if self.path == "/":
            self._headers("text/html")
            self.wfile.write(HTML_PAGE.encode("utf-8"))

        elif self.path == "/api/dashboard":
            self._headers()
            content, exists = self._read_file(LIVE_MD)
            age = self._file_age(LIVE_MD)

            events = []
            ev_content, ev_exists = self._read_file(EVENTS_JSONL)
            if ev_exists and ev_content.strip():
                lines = ev_content.strip().split("\n")
                # Take last N events
                for line in lines[-MAX_EVENTS:]:
                    line = line.strip()
                    if line:
                        try:
                            events.append(json.loads(line))
                        except json.JSONDecodeError:
                            pass

            resp = json.dumps({
                "dashboard": content,
                "exists": exists,
                "age": age,
                "mode": self._parse_mode(events),
                "events": events,
                "warnings": self._read_warnings(),
            })
            self.wfile.write(resp.encode("utf-8"))

        elif self.path == "/api/state":
            self._headers()
            content, exists = self._read_file(STATE_YAML)
            resp = json.dumps({
                "content": content,
                "exists": exists,
            })
            self.wfile.write(resp.encode("utf-8"))

        else:
            self._headers(status=404)
            self.wfile.write(b'{"error": "not found"}')


import socket, signal, subprocess

# Kill any previous monitor on this port
try:
    out = subprocess.check_output(["lsof", "-ti", f":{PORT}"], stderr=subprocess.DEVNULL).decode().strip()
    for pid in out.split("\n"):
        pid = pid.strip()
        if pid and int(pid) != os.getpid():
            os.kill(int(pid), signal.SIGTERM)
            import time; time.sleep(0.3)
except (subprocess.CalledProcessError, ValueError, ProcessLookupError):
    pass

# ThreadingHTTPServer (not the single-threaded HTTPServer): the browser fires
# two concurrent requests every poll (/api/dashboard + /api/state), and any one
# slow or stalled connection on a single-threaded server wedges serve_forever()
# indefinitely — the port stays bound (monitor *looks* alive) but never serves
# fresh data again. That was the root of the "monitor shows no changes / goes
# unstable" reports; prior fixes only touched the ETA algorithm, never the
# server. daemon_threads=True lets the process exit cleanly without joining
# stuck worker threads.
class ReuseServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True
    def server_bind(self):
        self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        super().server_bind()

server = ReuseServer(("127.0.0.1", PORT), Handler)
print(f"\n  {MONITOR_NAME} — Orchestrator Monitor")
print(f"  http://localhost:{PORT}")
print(f"  Watching: {BASE_DIR}")
print(f"  Polling every {INTERVAL}s | Showing last {MAX_EVENTS} events")
print(f"  Press Ctrl+C to stop\n")

try:
    server.serve_forever()
except KeyboardInterrupt:
    print("\n  Stopped.")
    server.server_close()
